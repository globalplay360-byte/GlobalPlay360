CREATE_CHECKOUT_SESSION_MIN_INSTANCES=0
CUSTOMERS_COLLECTION=customers
DELETE_STRIPE_CUSTOMERS=Do not delete
LOCATION=europe-west1
PRODUCTS_COLLECTION=products
# Els secrets apunten a `latest`, no a una versio fixa.
#
# Fins al 6 ago 2026 apuntaven a `versions/1`. Amb aixo, posar la clau LIVE al
# Secret Manager creava una versio 2 que l'extensio no llegia mai: hauria seguit
# cobrant en mode TEST sense donar cap error. Un pagament real no hauria arribat
# enlloc i no ho hauria vist ningu.
#
# Amb `latest`, afegir una versio nova del secret i tornar a desplegar
# l'extensio es suficient. A canvi, qualsevol versio nova te efecte al seguent
# desplegament: no es crea cap versio de secret sense voler-ho.
STRIPE_API_KEY=projects/918697579869/secrets/ext-firestore-stripe-payments-STRIPE_API_KEY/versions/latest
STRIPE_CONFIG_COLLECTION=configuration
STRIPE_WEBHOOK_SECRET=projects/918697579869/secrets/ext-firestore-stripe-payments-STRIPE_WEBHOOK_SECRET/versions/latest
SYNC_USERS_ON_CREATE=Do not sync